{
  "manifest_version": 3,
  "name": "CodeLedger",
  "version": "1.3",

  "description": "Copies formatted solution filenames on Codeforces, LeetCode and CSES and remembers your Codeforces submission filters.",

  "browser_specific_settings": {
    "gecko": {
      "id": "codeledger@bobby",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "host_permissions": [
    "*://*.codeforces.com/*",
    "*://*.leetcode.com/*",
    "*://*.cses.fi/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.codeforces.com/*",
        "*://*.leetcode.com/*",
        "*://*.cses.fi/*"
      ],
      "js": [
        "src/features/copy-button/copy-button.js",
        "src/features/question-parser/codeforces/question-parser-cf.js",
        "src/features/question-parser/codeforces/filter-lock.js",
        "src/features/question-parser/leetcode/question-parser-lc.js",
        "src/features/question-parser/cses/question-parser-cses.js",
        "src/core/main.js"
      ],
      "css": ["src/features/copy-button/copy-button.css"]
    }
  ]
}
