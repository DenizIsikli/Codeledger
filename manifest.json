{
  "manifest_version": 3,
  "name": "CodeLedger",
  "version": "1.1",

  "description": "Copies formatted solution filenames on Codeforces and LeetCode, and remembers your Codeforces submission filters.",

  "browser_specific_settings": {
    "gecko": {
      "id": "codeledger@bobby",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "host_permissions": ["*://*.codeforces.com/*", "*://*.leetcode.com/*"],

  "content_scripts": [
    {
      "matches": ["*://*.codeforces.com/*", "*://*.leetcode.com/*"],
      "js": [
        "src/features/copy-button/copy-button.js",
        "src/features/question-parser/codeforces/question-parser-cf.js",
        "src/features/question-parser/codeforces/filter-lock.js",
        "src/features/question-parser/leetcode/question-parser-lc.js",
        "src/core/main.js"
      ],
      "css": ["src/features/copy-button/copy-button.css"]
    }
  ]
}
